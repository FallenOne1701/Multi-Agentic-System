# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Reviewer outgoing scan (Gemini). Specialists keep using Groq.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Set to 0 to force keyword/regex classifiers (tests, offline).
GROWW_USE_LLM=1
# Render (or local) API — optional path overrides
# DATA_DIR=
# OUTPUT_DIR=
# Production CORS: https://<project>.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

